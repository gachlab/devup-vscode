{
  "name": "devup-vscode",
  "displayName": "devup",
  "description": "Sidebar tree, status bar, and live logs for @gachlab/devup — control your dev stack without leaving the editor.",
  "version": "0.7.0",
  "publisher": "gachlab",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "devup",
    "dev",
    "monorepo",
    "microservices",
    "process-manager",
    "dev-stack",
    "terminal",
    "logs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gachlab/devup-vscode.git"
  },
  "homepage": "https://github.com/gachlab/devup-vscode#readme",
  "bugs": {
    "url": "https://github.com/gachlab/devup-vscode/issues"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:devup.config.ts",
    "workspaceContains:devup.config.js",
    "workspaceContains:devup.config.json"
  ],
  "contributes": {
    "configuration": {
      "title": "devup",
      "properties": {
        "devup.projectName": {
          "type": "string",
          "default": "",
          "description": "Override the devup project name (normally auto-detected from devup.config.*). Used to resolve the control-plane socket at ~/.devup/sock-<name>.sock."
        },
        "devup.socketPath": {
          "type": "string",
          "default": "",
          "description": "Override the control-plane socket path entirely. When set, devup.projectName is ignored."
        },
        "devup.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to devup executable. If empty, uses 'npx devup' which searches node_modules first, then global PATH."
        },
        "devup.portForwarding": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "all",
            "web",
            "off"
          ],
          "enumDescriptions": [
            "Forward every service port — default. A web app is useless without the APIs it calls.",
            "Forward web service ports only. The frontends load, but their API calls will not resolve.",
            "Stop forwarding new ports. Tunnels already open stay open; close them from the Ports view."
          ],
          "default": "all",
          "description": "In a remote window (Remote-SSH, Dev Containers, WSL, Codespaces), ask the editor to tunnel devup service ports back to you. The daemon spawns services detached, so VS Code cannot auto-detect them. The Ports view shows the address to use: usually http://localhost:<port>, though the editor remaps the port when it is already taken locally, and Codespaces publishes to a hosted URL instead. Individual ports can be excluded with remote.portsAttributes onAutoForward \"ignore\". Ignored in local windows."
        },
        "devup.treeView.groupBy": {
          "type": "string",
          "enum": [
            "type",
            "phase",
            "none"
          ],
          "enumDescriptions": [
            "Group by service type (APIs / Webs) — default",
            "Group by boot phase (phase 0, phase 1, …)",
            "Flat list — no grouping"
          ],
          "default": "type",
          "description": "How to group services in the sidebar tree."
        },
        "devup.profile": {
          "type": "string",
          "default": "",
          "description": "Active profile filter. When set, only services belonging to this profile are shown. Leave empty to show all services."
        },
        "devup.stats.cpuWarnThreshold": {
          "type": "number",
          "default": 80,
          "description": "CPU% threshold for warning icon on service tree items."
        },
        "devup.stats.memWarnThresholdMB": {
          "type": "number",
          "default": 500,
          "description": "Memory (MB) threshold for warning icon on service tree items."
        },
        "devup.stats.cpuHighThreshold": {
          "type": "number",
          "default": 95,
          "description": "CPU% threshold for red (critical) icon on service tree items."
        },
        "devup.stats.memHighThresholdMB": {
          "type": "number",
          "default": 1024,
          "description": "Memory (MB) threshold for red (critical) icon on service tree items."
        },
        "devup.logDir": {
          "type": "string",
          "default": "",
          "description": "Root of devup's log directory, when the daemon was started with --log-dir. Empty = ~/.devup/logs. The daemon does not publish this over the control plane, so it has to be repeated here for 'Open log file' to find anything."
        },
        "devup.notifications.configReload": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when the daemon hot-reloads the config and services are added or removed."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "devupServices",
        "contents": "No devup daemon is running for this project.\n[Start daemon (devup up -d)](command:devup.daemon.start)\n[Why can't it be reached?](command:devup.diagnostics)",
        "when": "devup.diagnosis == socketMissing"
      },
      {
        "view": "devupServices",
        "contents": "The socket for this project exists, but the daemon is not answering — it may still be starting, may be wedged, or the file may be left over from a crash.\n[Restart daemon](command:devup.daemon.restart)\n[Show connection details](command:devup.diagnostics)",
        "when": "devup.diagnosis == noAnswer"
      },
      {
        "view": "devupServices",
        "contents": "The project name could not be read from your devup config, so the socket path was guessed from the folder name — which matches a running daemon only by coincidence.\n[Set the project name](command:devup.setProjectName)\n[Show connection details](command:devup.diagnostics)",
        "when": "devup.diagnosis == guessedName"
      },
      {
        "view": "devupServices",
        "contents": "Open the folder that holds your devup.config.* to control its stack from here.\n[Open Folder](command:workbench.action.files.openFolder)\n\n[Open devup documentation](https://github.com/gachlab/devup#readme)",
        "when": "devup.diagnosis == noWorkspace"
      },
      {
        "view": "devupServices",
        "contents": "No devup.config.ts, .js or .json was found in this workspace, so there is no project name to resolve a daemon socket from.\n[Set the project name](command:devup.setProjectName)\n[Show connection details](command:devup.diagnostics)\n\n[Open devup documentation](https://github.com/gachlab/devup#readme)",
        "when": "devup.diagnosis == noConfig"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devup",
          "title": "devup",
          "icon": "media/devup.svg"
        }
      ]
    },
    "views": {
      "devup": [
        {
          "id": "devupServices",
          "name": "Services",
          "contextualTitle": "devup"
        }
      ]
    },
    "commands": [
      {
        "command": "devup.showStatus",
        "title": "devup: Show status"
      },
      {
        "command": "devup.tailLogs",
        "title": "devup: Tail logs for a service…",
        "icon": "$(output)"
      },
      {
        "command": "devup.restart",
        "title": "devup: Restart service",
        "icon": "$(refresh)"
      },
      {
        "command": "devup.stop",
        "title": "devup: Stop service",
        "icon": "$(stop)"
      },
      {
        "command": "devup.openInBrowser",
        "title": "devup: Open in browser",
        "icon": "$(globe)"
      },
      {
        "command": "devup.refresh",
        "title": "devup: Refresh services",
        "icon": "$(refresh)"
      },
      {
        "command": "devup.daemon.start",
        "title": "devup: Start daemon (devup up -d)",
        "icon": "$(play)"
      },
      {
        "command": "devup.daemon.stop",
        "title": "devup: Stop daemon (devup down)",
        "icon": "$(stop-circle)"
      },
      {
        "command": "devup.daemon.restart",
        "title": "devup: Restart daemon",
        "icon": "$(debug-restart)"
      },
      {
        "command": "devup.openServiceDetail",
        "title": "devup: Open service detail",
        "icon": "$(preview)"
      },
      {
        "command": "devup.pickProfile",
        "title": "devup: Select active profile",
        "icon": "$(layers)"
      },
      {
        "command": "devup.openTerminal",
        "title": "devup: Open terminal in service cwd",
        "icon": "$(terminal)"
      },
      {
        "command": "devup.copyUrl",
        "title": "devup: Copy service URL",
        "icon": "$(clippy)"
      },
      {
        "command": "devup.openLogFile",
        "title": "devup: Open log file",
        "icon": "$(file)"
      },
      {
        "command": "devup.revealLogs",
        "title": "devup: Reveal logs folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "devup.closeForwardedPorts",
        "title": "devup: Close forwarded ports…",
        "icon": "$(plug)"
      },
      {
        "command": "devup.diagnostics",
        "title": "devup: Show connection details",
        "icon": "$(info)"
      },
      {
        "command": "devup.setProjectName",
        "title": "devup: Set the project name…",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devup.refresh",
          "when": "view == devupServices",
          "group": "navigation@0"
        },
        {
          "command": "devup.daemon.start",
          "when": "view == devupServices && !devup.daemonReachable",
          "group": "navigation@1"
        },
        {
          "command": "devup.daemon.restart",
          "when": "view == devupServices && devup.daemonReachable",
          "group": "navigation@1"
        },
        {
          "command": "devup.daemon.stop",
          "when": "view == devupServices && devup.daemonReachable",
          "group": "navigation@2"
        },
        {
          "command": "devup.revealLogs",
          "when": "view == devupServices",
          "group": "1_devup@1"
        },
        {
          "command": "devup.closeForwardedPorts",
          "when": "view == devupServices && devup.remote",
          "group": "1_devup@2"
        },
        {
          "command": "devup.diagnostics",
          "when": "view == devupServices",
          "group": "1_devup@3"
        }
      ],
      "view/item/context": [
        {
          "command": "devup.openServiceDetail",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "inline@1"
        },
        {
          "command": "devup.tailLogs",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "inline@2"
        },
        {
          "command": "devup.restart",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "inline@3"
        },
        {
          "command": "devup.openServiceDetail",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "1_actions@1"
        },
        {
          "command": "devup.openInBrowser",
          "when": "view == devupServices && viewItem == service-web",
          "group": "1_actions@2"
        },
        {
          "command": "devup.tailLogs",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "1_actions@3"
        },
        {
          "command": "devup.restart",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "1_actions@4"
        },
        {
          "command": "devup.stop",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "1_actions@5"
        },
        {
          "command": "devup.openTerminal",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "1_actions@6"
        },
        {
          "command": "devup.copyUrl",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "2_share@1"
        },
        {
          "command": "devup.openLogFile",
          "when": "view == devupServices && viewItem =~ /service-/",
          "group": "2_share@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build -- --production",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "npm run build && vscode-test",
    "test": "npm run test:unit"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2"
  }
}
